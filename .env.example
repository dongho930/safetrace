# 실제 값은 `python scripts/gen_secrets.py` 로 .env 를 생성한다. 이 파일에는 비밀값을 넣지 않는다.
SAFETRACE_ENV=dev
# {"<sha256(token)>": "user:role"}  role ∈ viewer|investigator|reviewer|automation
SAFETRACE_API_TOKENS={}
SAFETRACE_SIGNER_TOKEN=
SAFETRACE_WORKER_TOKEN=
SAFETRACE_DB_PASSWORD=
SAFETRACE_REDIS_PASSWORD=
SAFETRACE_SAFE_BROWSING_API_KEY=
# 네이버 검색 API(네이버 클라우드 플랫폼 NAVER API HUB 에서 발급한 API Key ID / API Key)
SAFETRACE_NAVER_CLIENT_ID=
SAFETRACE_NAVER_CLIENT_SECRET=
SAFETRACE_SIGNER_KEY_FILE=secrets/signer_key.hex
# 로컬 시험 사이트 허용(개발 전용, prod 에서 무시). JSON 배열.
SAFETRACE_TEST_ALLOW_HOSTPORTS=["localhost:8765"]
# 1 이면 로컬 제로샷 분류 모델을 로드한다(pip install -e "backend[ai]" 필요)
SAFETRACE_ZEROSHOT=0
